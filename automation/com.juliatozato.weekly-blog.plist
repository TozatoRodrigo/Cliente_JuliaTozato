<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.juliatozato.weekly-blog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/rodrigodiastozato/Desktop/site_julia/automation/run-weekly-blog.sh</string>
  </array>

  <!-- Toda segunda-feira às 09:00 (horário local America/Sao_Paulo).
       Se o Mac estiver desligado/dormindo no horário, o launchd dispara
       assim que ele acordar. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/rodrigodiastozato/Desktop/site_julia/automation/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/rodrigodiastozato/Desktop/site_julia/automation/logs/launchd.err.log</string>
</dict>
</plist>
