---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaWhatsApp from '../components/CtaWhatsApp.astro';
import Faq from '../components/Faq.astro';
import PostCard from '../components/PostCard.astro';
import { ADDRESS, CONTACT, OPENING_HOURS, PROFESSIONAL } from '../lib/constants';
import { faqSchema, personSchema, psychologistBusinessSchema, websiteSchema, type FaqItem } from '../lib/seo';
import juliaPortrait from '../assets/images/julia-dias-tozato-psicologa-neuropsicologa-santos.jpg';
import juliaFaixa from '../assets/images/julia-tozato-neuropsicologa-santos.jpg';

const services = [
  {
    title: 'Avaliação Neuropsicológica',
    href: '/avaliacao-neuropsicologica',
    text: 'Investigação completa de atenção, memória, linguagem e raciocínio, com laudo detalhado para orientar diagnóstico e tratamento.',
  },
  {
    title: 'Avaliação de TDAH',
    href: '/avaliacao-tdah',
    text: 'Avaliação especializada de TDAH em crianças, adolescentes e adultos, com instrumentos padronizados.',
  },
  {
    title: 'Avaliação de Autismo (TEA)',
    href: '/avaliacao-tea',
    text: 'Investigação de sinais do Transtorno do Espectro Autista, incluindo apresentações mais sutis (nível 1 de suporte).',
  },
  {
    title: 'Neuropsicologia Infantil',
    href: '/neuropsicologia-infantil',
    text: 'Avaliação e estimulação cognitiva para crianças, com abordagem lúdica — inclusive por meio de jogos.',
  },
  {
    title: 'Terapia para Adultos',
    href: '/terapia-para-adultos',
    text: 'Psicoterapia individual para ansiedade, depressão, estresse, autoconhecimento e fases de transição.',
  },
  {
    title: 'Terapia para Adolescentes',
    href: '/terapia-para-adolescentes',
    text: 'Acompanhamento psicológico para adolescentes, em parceria com a família e a escola.',
  },
  {
    title: 'Terapia Online',
    href: '/terapia-online',
    text: 'Atendimento psicológico por videochamada para todo o Brasil, com a mesma qualidade do presencial.',
  },
  {
    title: 'Dificuldades de Aprendizagem',
    href: '/dificuldades-de-aprendizagem',
    text: 'Investigação de dislexia, discalculia e outras dificuldades escolares, com devolutiva para família e escola.',
  },
  {
    title: 'Avaliação Neuropsicológica em Idosos',
    href: '/avaliacao-neuropsicologica-idosos',
    text: 'Investigação de memória e atenção na terceira idade, diferenciando envelhecimento normal de sinais de alerta.',
  },
];

const faqs: FaqItem[] = [
  {
    question: 'A Julia atende presencialmente em qual endereço?',
    answer: `O atendimento presencial acontece no ${ADDRESS.clinicName}, na ${ADDRESS.full}. O agendamento é feito pelo WhatsApp ${CONTACT.phoneDisplay}.`,
  },
  {
    question: 'Ela atende online?',
    answer:
      'Sim. A psicoterapia online é oferecida para todo o Brasil, por videochamada, em conformidade com as resoluções do Conselho Federal de Psicologia.',
  },
  {
    question: 'Qual a diferença entre psicóloga e neuropsicóloga?',
    answer:
      'A psicóloga clínica realiza psicoterapia — o acompanhamento emocional e comportamental. A neuropsicóloga investiga a relação entre cérebro e comportamento, avaliando funções como atenção, memória e linguagem. A Julia atua nas duas frentes.',
  },
  {
    question: 'Como agendar uma consulta?',
    answer: `Basta enviar uma mensagem pelo WhatsApp ${CONTACT.phoneDisplay}. A Julia responde pessoalmente, entende a sua necessidade e encontra o melhor horário.`,
  },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const schemas = [websiteSchema(), psychologistBusinessSchema(), personSchema(), faqSchema(faqs)];
---

<BaseLayout
  title="Psicóloga e Neuropsicóloga em Santos | Julia Dias Tozato"
  description={`Julia Dias Tozato é psicóloga e neuropsicóloga em Santos-SP (${PROFESSIONAL.crp}). Avaliação neuropsicológica e psicoterapia presencial e online. Agende: ${CONTACT.phoneDisplay}.`}
  path="/"
  schemas={schemas}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-cream">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-[3fr_2fr]">
      <div>
        <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">
          {PROFESSIONAL.crp} · Santos-SP e online
        </p>
        <h1 class="mt-3 font-serif text-4xl leading-tight font-semibold text-brand-900 sm:text-5xl">
          Psicóloga e Neuropsicóloga em Santos
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink/90">
          Cuidado psicológico e avaliação neuropsicológica para crianças, adolescentes e adultos.
          Atendimento presencial no bairro Boqueirão, em Santos, e online para todo o Brasil.
        </p>
        <p class="mt-4 max-w-xl text-sm font-medium text-brand-700">
          Neuropsicóloga com formação pelo Hospital Israelita Albert Einstein · Especialista em
          Terapia Cognitivo-Comportamental e Análise do Comportamento · Supervisora clínica
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={CONTACT.whatsappUrl}
            target="_blank"
            rel="noopener"
            class="rounded-full bg-brand-700 px-6 py-3 font-semibold text-white shadow transition-colors hover:bg-brand-800"
          >
            Agendar pelo WhatsApp
          </a>
          <a
            href="/avaliacao-neuropsicologica"
            class="rounded-full border border-brand-300 px-6 py-3 font-semibold text-brand-800 transition-colors hover:bg-brand-50"
          >
            Conhecer a avaliação neuropsicológica
          </a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-sm">
        <div class="absolute -inset-3 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-200 via-brand-100 to-accent-100"></div>
        <Image
          src={juliaPortrait}
          alt="Julia Dias Tozato, psicóloga e neuropsicóloga em Santos-SP"
          widths={[400, 600, 900]}
          sizes="(min-width: 1024px) 380px, 90vw"
          loading="eager"
          class="aspect-[4/5] w-full rounded-[1.75rem] object-cover object-top shadow-lg ring-1 ring-brand-200/60"
        />
      </div>
    </div>
  </section>

  <!-- Quem é a Julia -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="max-w-3xl">
      <h2 class="font-serif text-3xl font-semibold text-brand-900">Quem é a Julia</h2>
      <p class="mt-4 leading-relaxed text-ink/90">
        {PROFESSIONAL.entitySentence} Graduada em Psicologia pela Universidade Católica de Santos,
        atua também como supervisora clínica e acredita que cuidar da mente pode — e deve — ser um
        processo acolhedor, humano e baseado em evidências.
      </p>
      <a href="/sobre" class="mt-4 inline-block font-semibold text-brand-700 hover:underline">
        Conheça a formação e a abordagem da Julia →
      </a>
    </div>
  </section>

  <!-- Serviços -->
  <section class="bg-white py-14">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="font-serif text-3xl font-semibold text-brand-900">Como posso te ajudar</h2>
      <p class="mt-2 max-w-2xl text-ink/80">
        Cada serviço tem uma página com explicação completa — o que é, para quem é indicado e como funciona.
      </p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((service) => (
            <a
              href={service.href}
              class="group flex h-full flex-col rounded-2xl border border-brand-100 bg-cream p-6 transition-all hover:border-brand-300 hover:shadow-md"
            >
              <h3 class="font-serif text-lg font-semibold text-brand-900 group-hover:text-brand-700">
                {service.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/80">{service.text}</p>
              <span class="mt-4 text-sm font-semibold text-brand-700">Saiba mais →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Presencial vs Online -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="font-serif text-3xl font-semibold text-brand-900">Presencial em Santos ou online</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-brand-100 bg-white p-8">
        <h3 class="font-serif text-xl font-semibold text-brand-900">Atendimento presencial</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink/85">
          No {ADDRESS.clinicName}, um espaço pensado para acolhimento e avaliação, na
          {' '}{ADDRESS.full}. {OPENING_HOURS}.
        </p>
        <a href="/consultorio" class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline">
          Ver localização e como chegar →
        </a>
      </div>
      <div class="rounded-2xl border border-brand-100 bg-white p-8">
        <h3 class="font-serif text-xl font-semibold text-brand-900">Atendimento online</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink/85">
          Psicoterapia por videochamada para todo o Brasil, com a mesma ética, sigilo e qualidade do
          presencial — regulamentada pelo Conselho Federal de Psicologia.
        </p>
        <a href="/terapia-online" class="mt-4 inline-block text-sm font-semibold text-brand-700 hover:underline">
          Como funciona a terapia online →
        </a>
      </div>
    </div>
  </section>

  <!-- Faixa: cuidado humano + credenciais, com foto -->
  <section class="bg-gradient-to-br from-brand-50 via-cream to-accent-100/40">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-[3fr_2fr]">
      <div>
        <h2 class="font-serif text-3xl font-semibold text-brand-900 sm:text-4xl">
          Um cuidado humano, criterioso e no seu ritmo
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink/85">
          Cada pessoa chega com uma história única. A Julia une a escuta da psicologia clínica à
          precisão da neuropsicologia — com formação pelo Hospital Israelita Albert Einstein e
          especialização em Terapia Cognitivo-Comportamental e Análise do Comportamento — para um
          acompanhamento acolhedor e baseado em evidências, presencial em Santos ou online.
        </p>
        <a
          href={CONTACT.whatsappUrl}
          target="_blank"
          rel="noopener"
          data-umami-event="whatsapp-click"
          data-umami-event-page="/#faixa"
          class="mt-6 inline-block rounded-full bg-brand-700 px-6 py-3 font-semibold text-white shadow transition-colors hover:bg-brand-800"
        >
          Conversar com a Julia
        </a>
      </div>

      <div class="relative mx-auto w-full max-w-xs">
        <div class="absolute -inset-3 -z-10 rounded-[2rem] bg-gradient-to-br from-brand-200 via-brand-100 to-accent-100"></div>
        <Image
          src={juliaFaixa}
          alt="Julia Dias Tozato, neuropsicóloga e psicóloga em Santos-SP"
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 320px, 80vw"
          loading="lazy"
          class="aspect-[3/4] w-full rounded-[1.75rem] object-cover object-top shadow-lg ring-1 ring-brand-200/60"
        />
      </div>
    </div>
  </section>

  <!-- Como agendar -->
  <section class="bg-brand-50 py-14">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="font-serif text-3xl font-semibold text-brand-900">Agendar é simples</h2>
      <ol class="mt-8 grid gap-6 md:grid-cols-3">
        {
          [
            ['1. Envie uma mensagem', `Chame no WhatsApp ${CONTACT.phoneDisplay} contando, em poucas palavras, o que você procura.`],
            ['2. Converse com a Julia', 'Ela vai entender a sua necessidade e indicar o formato mais adequado — psicoterapia ou avaliação, presencial ou online.'],
            ['3. Comece o acompanhamento', 'Vocês combinam dia e horário, e o cuidado começa no seu ritmo, com sigilo e acolhimento.'],
          ].map(([title, text]) => (
            <li class="rounded-2xl bg-white p-6">
              <p class="font-serif text-lg font-semibold text-brand-900">{title}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/85">{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ + Blog -->
  <section class="mx-auto max-w-3xl px-4">
    <Faq items={faqs} />
  </section>

  {
    posts.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-6">
        <div class="flex items-baseline justify-between">
          <h2 class="font-serif text-3xl font-semibold text-brand-900">Do blog</h2>
          <a href="/blog" class="text-sm font-semibold text-brand-700 hover:underline">
            Ver todos os artigos →
          </a>
        </div>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )
  }

  <div class="mx-auto max-w-3xl px-4">
    <CtaWhatsApp />
  </div>
</BaseLayout>
