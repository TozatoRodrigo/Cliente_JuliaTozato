---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaWhatsApp from '../../components/CtaWhatsApp.astro';
import Faq from '../../components/Faq.astro';
import { BLOG_CATEGORIES } from '../../lib/constants';
import { blogPostingSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const path = `/blog/${post.id}`;
const breadcrumbs = [
  { name: 'Início', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: post.data.title, path },
];

const schemas = [
  blogPostingSchema({
    title: post.data.title,
    description: post.data.description,
    path,
    pubDate: post.data.pubDate,
    updatedDate: post.data.updatedDate,
  }),
  breadcrumbSchema(breadcrumbs),
  ...(post.data.faqs.length > 0 ? [faqSchema(post.data.faqs)] : []),
];

const dateFormatted = post.data.pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={path}
  ogType="article"
  schemas={schemas}
>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8">
      <p class="flex items-center gap-3 text-sm text-brand-600">
        <a
          href={`/blog/categoria/${post.data.category}`}
          class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold tracking-wide uppercase hover:bg-brand-100"
        >
          {BLOG_CATEGORIES[post.data.category]}
        </a>
        <time datetime={post.data.pubDate.toISOString()}>{dateFormatted}</time>
      </p>
      <h1 class="mt-4 font-serif text-3xl leading-tight font-semibold text-brand-900 sm:text-4xl">
        {post.data.title}
      </h1>
    </header>

    <div class="prose-site">
      <Content />
    </div>

    <Faq items={post.data.faqs} />
    <AuthorBox />
    <CtaWhatsApp />
  </article>
</BaseLayout>
