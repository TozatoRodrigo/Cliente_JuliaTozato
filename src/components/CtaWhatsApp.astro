---
import { CONTACT } from '../lib/constants';

interface Props {
  /** Título contextual do bloco de CTA */
  heading?: string;
  text?: string;
}

const {
  heading = 'Que tal dar o primeiro passo?',
  text = 'Envie uma mensagem pelo WhatsApp para tirar dúvidas ou agendar uma primeira conversa, presencial em Santos ou online.',
} = Astro.props;
---

<section class="my-12 rounded-2xl bg-brand-700 px-6 py-10 text-center text-white sm:px-10">
  <h2 class="font-serif text-2xl font-semibold">{heading}</h2>
  <p class="mx-auto mt-3 max-w-xl text-brand-100">{text}</p>
  <a
    href={CONTACT.whatsappUrl}
    target="_blank"
    rel="noopener"
    data-umami-event="whatsapp-click"
    data-umami-event-page={Astro.url.pathname}
    class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 font-semibold text-brand-800 shadow transition-transform hover:scale-105"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.2 14.2c-.2.6-1.2 1.1-1.7 1.2-.5 0-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.1.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.3 1.4 2.6 1.6.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .8-.3 1.5Z"
      />
    </svg>
    Falar com a Julia — {CONTACT.phoneDisplay}
  </a>
</section>
