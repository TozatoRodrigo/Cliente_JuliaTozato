---
import type { CollectionEntry } from 'astro:content';
import { BLOG_CATEGORIES } from '../lib/constants';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const dateFormatted = post.data.pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<article class="flex h-full flex-col rounded-2xl border border-brand-100 bg-white p-6 transition-shadow hover:shadow-md">
  <p class="mb-2 flex items-center gap-2 text-xs font-medium tracking-wide text-brand-600 uppercase">
    <a href={`/blog/categoria/${post.data.category}`} class="rounded-full bg-brand-50 px-2.5 py-1 hover:bg-brand-100">
      {BLOG_CATEGORIES[post.data.category]}
    </a>
    <time datetime={post.data.pubDate.toISOString()}>{dateFormatted}</time>
  </p>
  <h3 class="font-serif text-xl font-semibold text-brand-900">
    <a href={`/blog/${post.id}`} class="hover:text-brand-700">{post.data.title}</a>
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/80">{post.data.description}</p>
  <a href={`/blog/${post.id}`} class="mt-4 text-sm font-semibold text-brand-700 hover:underline">
    Continuar lendo →
  </a>
</article>
