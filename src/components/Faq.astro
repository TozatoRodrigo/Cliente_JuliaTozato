---
import type { FaqItem } from '../lib/seo';

interface Props {
  items: readonly FaqItem[];
  heading?: string;
}

const { items, heading = 'Perguntas frequentes' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="my-12">
      <h2 class="mb-6 font-serif text-2xl font-semibold text-brand-800">{heading}</h2>
      <div class="space-y-3">
        {items.map((item) => (
          <details class="group rounded-xl border border-brand-100 bg-white px-5 py-4">
            <summary class="cursor-pointer list-none font-medium text-brand-900 marker:hidden">
              <span class="flex items-center justify-between gap-4">
                {item.question}
                <span class="text-brand-400 transition-transform group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </span>
            </summary>
            <p class="mt-3 leading-relaxed text-ink/90">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
