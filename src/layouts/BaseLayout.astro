---
import { getImage } from 'astro:assets';
import '@fontsource-variable/inter';
import '@fontsource-variable/lora';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ANALYTICS, SITE_NAME, SITE_URL } from '../lib/constants';
import juliaPortrait from '../assets/images/julia-dias-tozato-psicologa-neuropsicologa-santos.jpg';

interface Props {
  title: string;
  description: string;
  /** Caminho canônico, ex.: "/sobre" */
  path: string;
  ogType?: 'website' | 'article';
  /** Objetos JSON-LD prontos (builders em lib/seo.ts) */
  schemas?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, path, ogType = 'website', schemas = [], noindex = false } = Astro.props;
const canonical = new URL(path === '/' ? '/' : path, SITE_URL).href;

/** Imagem padrão de compartilhamento social (og:image) — mesma foto em todas as páginas. */
const ogImage = await getImage({ src: juliaPortrait, width: 1200 });
const ogImageUrl = new URL(ogImage.src, SITE_URL).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Blog — ${SITE_NAME}`}
      href={new URL('/rss.xml', SITE_URL).href}
    />
    <meta name="theme-color" content="#8f3f49" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.attributes.width)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}

    {
      ANALYTICS.websiteId && (
        <script
          defer
          src={ANALYTICS.scriptUrl}
          data-website-id={ANALYTICS.websiteId}
          data-domains="psicologajuliatozato.com.br"
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="skip-link">Pular para o conteúdo</a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
